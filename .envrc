if ! command -v mise >/dev/null; then
  echo "wt: mise not found — install via Homebrew (brew install mise) or https://mise.jdx.dev/" >&2
  return 0
fi

# Warn if the Go version drifts between go.mod and .go-version
watch_file go.mod .go-version
_gomod_go=$(awk '/^go [0-9]/ {print $2; exit}' go.mod)
_dotgo=$(tr -d '[:space:]' < .go-version)
if [[ "$_gomod_go" != "$_dotgo" ]]; then
  echo "wt: go.mod ($_gomod_go) and .go-version ($_dotgo) disagree — sync them" >&2
fi
unset _gomod_go _dotgo

# Load the mise-vendored toolchain onto PATH, and install the git hooks
watch_file mise.toml mise.lock
eval "$(mise env)"
if [[ -d .git && ! -f .git/hooks/pre-commit ]]; then
  mise generate git-pre-commit --task lint --write >/dev/null
fi
